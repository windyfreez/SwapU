#配置数据库的连接信息
spring:
  application:
    name: campus_second_hand

  #配置数据库的连接信息
  datasource:
    type: com.zaxxer.hikari.HikariDataSource
    url: jdbc:mysql://localhost:3306/your_database_name
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: your_username
    password: your_password

  redis:
    host: localhost
    port: 6379
    password: your_redis_password
    database: 0
    lettuce:
      pool:
        max-active: 8
        max-idle: 8
        min-idle: 0
        max-wait: -1ms

  servlet:
    multipart:
      #最大单个文件大小
      max-file-size: 10MB
      #最大请求大小（包括所有文件和表单数据）
      max-request-size: 100MB

  mvc:
    pathmatch:
      matching-strategy: ANT_PATH_MATCHER

#mybatis的相关配置
mybatis:
  mapper-locations: classpath:mapper/*.xml
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
    #开启驼峰命名规则映射
    map-underscore-to-camel-case: true


#接口文档配置，文档地址：http://localhost:8081/doc.html
knife4j:
  #开启knife4j增强，接口文档由 @Api/@ApiOperation/@ApiModelProperty 注解自动生成
  enable: true
  #生产环境置为 true 会屏蔽文档页面，避免对外暴露接口信息
  production: false
  setting:
    #文档界面语言：zh-CN 中文 / en-US 英文
    language: zh-CN
    #开启调试栏，可配合分组里的全局 token 请求头直接调试受保护接口
    enableDebug: true

#JWT配置
sky:
  jwt:
    #管理端
    admin-secret-key: your_admin_secret_key
    admin-ttl: 7200000
    admin-token-name: token
    #用户端
    user-secret-key: your_user_secret_key
    user-ttl: 7200000
    user-token-name: token

  alioss:
    endpoint: your_oss_endpoint
    # 密钥通过环境变量注入(必须设置,否则上传功能不可用)
    access-key-id: ${ALIYUN_ACCESS_KEY_ID}
    access-key-secret: ${ALIYUN_ACCESS_KEY_SECRET}
    bucket-name: your_bucket_name

