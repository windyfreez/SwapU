#配置数据库的连接信息
spring:
  application:
    name: campus_second_hand

  #配置数据库的连接信息
  datasource:
    type: com.zaxxer.hikari.HikariDataSource
    url: jdbc:mysql://localhost:3306/your_database_name
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: your_username
    password: your_password

  redis:
    host: localhost
    port: 6379
    password: your_redis_password
    database: 0
    lettuce:
      pool:
        max-active: 8
        max-idle: 8
        min-idle: 0
        max-wait: -1ms

  servlet:
    multipart:
      #最大单个文件大小
      max-file-size: 10MB
      #最大请求大小（包括所有文件和表单数据）
      max-request-size: 100MB

  mvc:
    pathmatch:
      matching-strategy: ANT_PATH_MATCHER

#mybatis的相关配置
mybatis:
  mapper-locations: classpath:mapper/*.xml
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
    #开启驼峰命名规则映射
    map-underscore-to-camel-case: true


knife4j:
  enable: true

#JWT配置
swapu:
  jwt:
    #管理端
    admin-secret-key: your_admin_secret_key
    admin-ttl: 7200000
    admin-token-name: token
    #用户端
    user-secret-key: your_user_secret_key
    user-ttl: 7200000
    user-token-name: token

  #推荐系统大模型语义重排序配置（api-key 复用 deepseek 配置）
  recommend:
    rerank:
      #是否启用大模型语义重排序，关闭后推荐退化为纯召回分排序
      enabled: true
      #参与重排序的最大候选商品数，控制请求体大小与费用
      max-candidates: 30
      #单次重排序连接超时（毫秒）
      connect-timeout: 3000
      #单次重排序读取响应超时（毫秒），比客服问答短，避免拖慢推荐接口
      read-timeout: 15000

  alioss:
    endpoint: your_oss_endpoint
    # 密钥通过环境变量注入(必须设置,否则上传功能不可用)
    access-key-id: ${ALIYUN_ACCESS_KEY_ID}
    access-key-secret: ${ALIYUN_ACCESS_KEY_SECRET}
    bucket-name: your_bucket_name

